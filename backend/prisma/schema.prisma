generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  MEMBER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  PENDING_PAYMENT
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String?    @map("password_hash")
  role         UserRole   @default(MEMBER)
  status       UserStatus @default(PENDING)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  memberProfile       MemberProfile?
  membership          Membership?
  businessCertificates BusinessCertificate[]

  @@map("users")
}

model MemberProfile {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  fullName            String   @map("full_name")
  phone               String
  location            String?
  profilePhoto        String?  @map("profile_photo")
  businessName        String?  @map("business_name")
  businessCategory    String?  @map("business_category")
  businessDescription String?  @map("business_description")
  businessLocation    String?  @map("business_location")
  website             String?
  instagram           String?
  facebook            String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("member_profiles")
}

model MembershipPlan {
  id           String   @id @default(uuid()) @db.Uuid
  planCode     String   @unique @map("plan_code")
  name         String
  badge        String?
  amount       Decimal  @db.Decimal(10, 2)
  billingCycle String   @default("LIFETIME") @map("billing_cycle")
  benefits     Json     @default("[]")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("membership_plans")
}

model Membership {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @unique @map("user_id") @db.Uuid
  memberId         String?          @unique @map("member_id")
  membershipType   String           @default("FOUNDING_MEMBER") @map("membership_type")
  membershipStatus MembershipStatus @default(PENDING_PAYMENT) @map("membership_status")
  amount           Decimal          @db.Decimal(10, 2)
  paymentStatus    PaymentStatus    @default(PENDING) @map("payment_status")
  paymentReference String?          @map("payment_reference")
  razorpayOrderId  String?          @map("razorpay_order_id")
  razorpayPaymentId String?         @map("razorpay_payment_id")
  razorpaySignature String?         @map("razorpay_signature")
  paidAt           DateTime?        @map("paid_at")
  joinedAt         DateTime?        @map("joined_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("memberships")
}

model BusinessCertificate {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  filePath      String   @map("file_path")
  fileName      String   @map("file_name")
  fileSizeBytes Int      @map("file_size_bytes")
  mimeType      String   @map("mime_type")
  uploadedAt    DateTime @default(now()) @map("uploaded_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("business_certificates")
}
