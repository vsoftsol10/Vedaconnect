# Server
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------
# Prisma -> Supabase Postgres
# Get both from: Supabase Dashboard -> Project Settings -> Database
# ------------------------------------------------------------------
# DATABASE_URL: the "Connection pooling" string (port 6543). Used for
# normal app queries at runtime.
DATABASE_URL="postgresql://postgres.[project-ref]:[your-db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: the "Direct connection" string (port 5432). Prisma needs
# this for schema/migration commands (not used at runtime).
DIRECT_URL="postgresql://postgres.[project-ref]:[your-db-password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------
# Supabase JS SDK - used ONLY for Storage (certificate uploads).
# Get from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT (backend only: used to sign and verify member/admin login tokens)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_ORIGIN=http://localhost:5173
# For multiple deployed frontends, use a comma-separated list in FRONTEND_ORIGINS.
# FRONTEND_ORIGINS=https://member.vedacraftscommunity.in,http://localhost:5173
